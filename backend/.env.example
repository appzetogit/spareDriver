# ---- Core ----
PORT=9000
# `development` keeps cookiee=Lax s as SameSit+ Secure=false so they stick on
# http://localhost. `production` switches them to SameSite=None + Secure=true,
# which is mandatory for the cross-site Vercel-SPA / standalone-API setup.
NODE_ENV=development
# Comma-separated list of allowed browser origins (no trailing slash).
# Example for production:
#   CLIENT_ORIGIN=https://app.example.com,https://admin.example.com
CLIENT_ORIGIN=http://localhost:5173
# Optional. Set only when the SPA and the API share a parent domain and you
# want first-party cookies across subdomains (e.g. `.example.com`). Leave
# unset for a typical Vercel SPA + separate API-host deployment.
# COOKIE_DOMAIN=.example.com

# ---- Database ----
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net
DB_NAME=spareDriver

# ---- Auth (HS256 JWT) ----
ACCESS_TOKEN_SECRET=change_me_access
REFRESH_TOKEN_SECRET=change_me_refresh
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ---- Default super admin (only used when no admin exists) ----
ADMIN_DEFAULT_EMAIL=admin@sparedriver.com
ADMIN_DEFAULT_PASSWORD=admin123

# ---- Cloudinary (file uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay (payments + payouts) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Socket.IO ----
# Print socket connect/disconnect lines in server logs (dev only).
SOCKET_DEBUG=false

# ---- Firebase Realtime Database (live driver locations) ----
# Phase 3 onward this becomes required. Phase 2 will gracefully no-op if unset.
#
# Provide credentials in ONE of these ways (priority order):
#   1. FIREBASE_SERVICE_ACCOUNT_JSON         — paste raw JSON on one line
#   2. FIREBASE_SERVICE_ACCOUNT_JSON_BASE64  — base64-encoded JSON (recommended for hosting)
#   3. FIREBASE_SERVICE_ACCOUNT_PATH         — relative path to JSON file (dev only)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
FIREBASE_SERVICE_ACCOUNT_PATH=
# e.g. https://sparedriver-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_URL=

# ---- Redis (BullMQ — scheduled bookings + emergency pool) ----
# BullMQ requires Redis. The scheduled-ride dispatcher and the 2h-before
# emergency-pool escalation both schedule jobs against this queue. If
# REDIS_URL is unset the worker is skipped at boot with a warning and
# every "schedule for later" booking falls back to an immediate search
# (so dev/CI keep working without Redis).
#
#   Local:      redis://localhost:6379
#   Upstash:    rediss://default:<token>@<host>:6379
#   ElastiCache redis://<endpoint>:6379
REDIS_URL=

# ---- Email (Resend and/or SMTP) ----
# Provider: `resend` (default), `smtp`, `both` (Resend then SMTP fallback), or `resend,smtp`
EMAIL_PROVIDER=both
RESEND_API_KEY=
EMAIL_FROM=SpareDriver <noreply@sparedriver.com>
# SMTP (used when EMAIL_PROVIDER=smtp or as fallback with `both`)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
# false for port 587 (STARTTLS). true only for port 465 (implicit TLS).
SMTP_SECURE=false

# ---- SMS / OTP ----
# Accept 1234 and 123456 without checking stored OTP (dev/QA bypass).
USE_DEFAULT_OTP=false
# Set true to send real SMS via SMS India Hub. When false, OTPs are logged to the server console only.
SMS_INDIA_HUB_ENABLED=false
SMS_INDIA_HUB_USERNAME=
# API password from cloud.smsindiahub.in (often different from the API key).
SMS_INDIA_HUB_PASSWORD=
SMS_INDIA_HUB_API_KEY=
# user_password (default) or api_key (APIKey= only, no username)
SMS_INDIA_HUB_AUTH_MODE=user_password
# send_sms (default, /api/mt/SendSMS) or pushsms (/vendorsms/pushsms.aspx)
SMS_INDIA_HUB_API_STYLE=send_sms
SMS_INDIA_HUB_SENDER_ID=
SMS_INDIA_HUB_DLT_TEMPLATE_ID=
# Optional DLT fields for SendSMS API
# SMS_INDIA_HUB_ROUTE=
# SMS_INDIA_HUB_PE_ID=
# Trans (OTP/transactional, default) or Promo
SMS_INDIA_HUB_CHANNEL=Trans
# Approved DLT template text. First ##var## = app name, second ##var## = OTP.
# IMPORTANT: wrap in double quotes — dotenv treats unquoted # as a comment.
SMS_INDIA_HUB_APP_NAME=SpareDriver
# SMS_INDIA_HUB_OTP_MESSAGE="Welcome to the ##var## powered by Appzeto.Your OTP for registration is ##var##.BGADEC"
SMS_INDIA_HUB_OTP_MESSAGE=
# Optional override (default: https://cloud.smsindiahub.in/vendorsms/pushsms.aspx)
# SMS_INDIA_HUB_API_URL=