{
  "name": "spare-driver-backend",
  "version": "1.0.0",
  "description": "SpareDriver platform backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "fix:payment-index": "node scripts/fixPaymentIndex.js",
    "backfill:subscription-numbers": "node scripts/backfillSubscriptionNumbers.js",
    "backfill:driver-numbers": "node scripts/backfillDriverNumbers.js",
    "backfill:driver-earnings": "node scripts/backfillDriverTripEarnings.js",
    "report:duplicate-revenue": "node scripts/reportDuplicatePlatformRevenue.js",
    "verify:concurrency": "node scripts/verifyConcurrencyGuards.js",
    "inspect:stuck": "node scripts/inspectStuckBooking.js",
    "seed": "node scripts/seed.js",
    "seed:fresh": "node scripts/seed.js --fresh",
    "seed:developer": "node scripts/seedDeveloper.js",
    "test": "node --test src/utils/outstationDuration.test.js src/utils/locationFix.test.js src/utils/stuckRecovery.test.js src/constants/bookingStatus.test.js src/utils/bookingIdempotency.test.js src/utils/adminBookingTransitions.test.js src/utils/arrivalFix.test.js src/config/sms.config.test.js",
    "test:stuck-recovery": "node --test src/utils/stuckRecovery.test.js",
    "test:idempotency": "node --test src/utils/bookingIdempotency.test.js",
    "test:outstation": "node --test src/utils/outstationDuration.test.js",
    "test:tracking": "node --test src/utils/locationFix.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.2",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.6.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "razorpay": "^2.9.6",
    "resend": "^4.1.2",
    "socket.io": "^4.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "qs": "^6.16.0"
  }
}
